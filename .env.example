# Default product. The -p/--product flag takes precedence; in a terminal the URL is always asked
# at startup (Enter = last product used). Without a terminal (pm2/launchd/systemd) -p or this value is required.
AMAZON_URL=

# Token from @BotFather and chat_id (see README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Polling interval with random jitter (ms)
MIN_POLL_INTERVAL_MS=9000
MAX_POLL_INTERVAL_MS=14000

# true = invisible Chromium, false = visible window (debugging / solving a CAPTCHA by hand)
HEADLESS=true

LOCAL_SOUND_ENABLED=true
OPEN_BROWSER_ON_AVAILABLE=false

TECHNICAL_NOTIFICATION_COOLDOWN_MINUTES=30

# debug | info | warn | error
LOG_LEVEL=info

# Telegram recap every N hours (0 = disabled). Can be changed while running with /recap N
RECAP_INTERVAL_HOURS=4

# --- Optional (default values) ---
# Consecutive errors (network / anomalous page) before a technical Telegram alert
# PROBLEM_ALERT_THRESHOLD=6
# Navigation timeout (ms)
# NAVIGATION_TIMEOUT_MS=30000
# Retry interval while Amazon asks for a CAPTCHA (ms)
# BLOCKED_RETRY_INTERVAL_MS=120000
# Skip images/fonts/media: faster page, less bandwidth
# BLOCK_HEAVY_RESOURCES=true
# Startup animation in the terminal (the interactive UI only runs in a real terminal)
# STARTUP_ANIMATION=true
