# Prodotto di default. Ha la precedenza il flag -p/--product; da terminale viene comunque chiesto
# all'avvio (Invio = ultimo prodotto usato). Senza terminale (pm2/launchd/systemd) serve -p o questo valore.
AMAZON_URL=

# Token di @BotFather e chat_id (vedi README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Intervallo di polling con jitter casuale (ms)
MIN_POLL_INTERVAL_MS=9000
MAX_POLL_INTERVAL_MS=14000

# true = Chromium invisibile, false = finestra visibile (debug / CAPTCHA manuale)
HEADLESS=true

LOCAL_SOUND_ENABLED=true
OPEN_BROWSER_ON_AVAILABLE=false

TECHNICAL_NOTIFICATION_COOLDOWN_MINUTES=30

# debug | info | warn | error
LOG_LEVEL=info

# Recap su Telegram ogni N ore (0 = disattivato). Modificabile a caldo con /recap N
RECAP_INTERVAL_HOURS=4

# --- Opzionali (valori di default) ---
# Errori consecutivi (rete / pagina anomala) prima di un Telegram tecnico
# PROBLEM_ALERT_THRESHOLD=6
# Timeout navigazione (ms)
# NAVIGATION_TIMEOUT_MS=30000
# Intervallo di ricontrollo quando Amazon chiede un CAPTCHA (ms)
# BLOCKED_RETRY_INTERVAL_MS=120000
# Non scarica immagini/font/media: pagina più veloce, meno banda
# BLOCK_HEAVY_RESOURCES=true
# Animazione di avvio nel terminale (la UI interattiva si attiva solo in un terminale vero)
# STARTUP_ANIMATION=true
