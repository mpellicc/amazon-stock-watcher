{
  "name": "amazon-stock-watcher",
  "version": "1.0.0",
  "private": true,
  "description": "Local Amazon availability watcher with Telegram notifications (no automatic purchases).",
  "author": "mpellicc (https://github.com/mpellicc)",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=26.10"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "go": "npm run build && npm run start",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:telegram": "tsx src/scripts/testTelegram.ts",
    "test:amazon": "tsx src/scripts/checkOnce.ts",
    "telegram:test": "npm run test:telegram",
    "amazon:test": "npm run test:amazon"
  },
  "dependencies": {
    "dotenv": "^18.0.3",
    "linkedom": "^0.18.13",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
